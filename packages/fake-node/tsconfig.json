{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["google-apps-script", "node"],
    "rootDir": "src",
    "outDir": "./dist",
    "module": "commonjs"
  },
  "exclude": ["node_modules", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "include": ["src"]
}
